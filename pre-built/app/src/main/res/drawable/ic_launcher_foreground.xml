<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground layer (API 26+). A minimal digital-display
  glyph - a rectangular bezel with a bold colon centered inside it -
  echoing the wallpaper's own "HH:MM" clock rather than an analog face
  the app has no equivalent of. Kept inside the 66dp "safe zone" (the
  circular area centered in the 108dp canvas that survives every
  launcher's icon mask). Monochrome white on the dark background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Display bezel: 48dp x 32dp rectangle, centered on the canvas -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F5F5F5"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:pathData="M30,38 h48 v32 h-48 z" />

    <!-- Colon, centered inside the bezel -->
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M54,48 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M54,60 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
</vector>
