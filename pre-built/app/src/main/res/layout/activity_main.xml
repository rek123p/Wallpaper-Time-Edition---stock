<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@android:color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_language_label"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/languageGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/languageSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_language_system"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/languageEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_language_en"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/languagePl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_language_pl"
                android:textColor="@android:color/white" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_format_label"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/timeFormatGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/format24h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_format_24h"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/format12h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_format_12h"
                android:textColor="@android:color/white" />

        </RadioGroup>

        <Button
            android:id="@+id/setWallpaperButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/set_wallpaper_button" />

    </LinearLayout>

</ScrollView>